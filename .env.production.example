# Application
APP_NAME=toolbox
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://toolbox.letunoff.ru
FRONTEND_URL=https://toolbox.letunoff.ru
SHORT_LINK_DOMAIN=https://go.letunoff.ru

# Authentication
REGISTER_INVITE_CODE=

SANCTUM_STATEFUL_DOMAINS=toolbox.letunoff.ru

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=toolbox
DB_USERNAME=
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_EXPIRE_ON_CLOSE=false
SESSION_DOMAIN=toolbox.letunoff.ru
SESSION_SECURE_COOKIE=true

# Cache & Queue
CACHE_STORE=file
QUEUE_CONNECTION=database

# Filesystem
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@letunoff.ru
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=