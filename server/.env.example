# Application
APP_NAME=ToolBox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SHORT_LINK_DOMAIN=http://localhost:3000

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Authentication
REGISTER_INVITE_CODE=
BCRYPT_ROUNDS=12

SANCTUM_STATEFUL_DOMAINS=localhost:3000,192.168.31.168:3000

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=toolbox
DB_USERNAME=
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_COOKIE=toolbox_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Cache & Queue
CACHE_STORE=file
QUEUE_CONNECTION=database

# Filesystem
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@letunoff.ru
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug